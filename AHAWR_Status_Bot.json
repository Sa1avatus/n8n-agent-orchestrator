      "typeVersion": 1.2,
      "position": [
        4880,
        1488
      ],
      "id": "c0639be1-71ef-407f-8519-20d1d9e9d9af",
      "name": "Poll Telegram"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "telegram_bot_token",
              "value": "REDACTED-BOT-TOKEN"
            }
