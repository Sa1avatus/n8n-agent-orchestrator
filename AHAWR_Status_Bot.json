{
  "name": "AHAWR Status Bot",
  "nodes": [
    {
      "parameters": {
        "jsCode": "const data = $getWorkflowStaticData('global');\nconst offset = Number.isFinite(Number(data.telegram_update_offset)) ? Number(data.telegram_update_offset) : 0;\nreturn [{ json: { offset } }];"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        5120,
        1488
      ],
      "id": "b69d96c2-a240-442d-ab1b-dd574f42ad7d",
