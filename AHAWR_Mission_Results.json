[{"id": "AhawrMissionRes01", "name": "AHAWR Mission Results", "active": false, "nodes": [{"parameters": {"inputSource": "passthrough"}, "type": "n8n-nodes-base.executeWorkflowTrigger", "typeVersion": 1.1, "position": [0, 0], "id": "mr-trigger", "name": "Results Trigger"}, {"parameters": {"operation": "get", "dataTableId": {"__rl": true, "mode": "name", "value": "Autonomous Agent Task Attempts"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "state_key", "keyValue": "={{ $json.state_key }}"}]}, "returnAll": true}, "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [220, 0], "id": "mr-history", "name": "Results History", "alwaysOutputData": true, "onError": "continueRegularOutput"}, {"parameters": {"operation": "get", "dataTableId": {"__rl": true, "mode": "name", "value": "Autonomous Agent Task State"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "state_key", "keyValue": "={{ $('Results Trigger').first().json.state_key }}"}]}, "limit": 1}, "type": "n8n-nodes-base.dataTable", "typeVersion": 1.1, "position": [440, 0], "id": "mr-state", "name": "Results State", "alwaysOutputData": true, "onError": "continueRegularOutput"}, {"parameters": {"jsCode": "const input = $('Results Trigger').first().json;\nconst history = $('Results History').all().map(i => i.json || {});\nconst state = ($('Results State').first() || { json: {} }).json || {};\nlet plan = {};\ntry { plan = JSON.parse(state.plan_json || '{}'); } catch (e) { plan = {}; }\nconst tasks = Array.isArray(plan.tasks) ? plan.tasks : [];\nconst passed = {}, operator = new Set(), attempts = {};\nfor (const h of history) {\n  if (h.event_type === 'review_parsed') {\n    attempts[h.task_id] = (attempts[h.task_id] || 0) + 1;\n    if (h.review_status === 'pass') passed[h.task_id] = Number(h.review_score || 0);\n  } else if (h.event_type === 'operator_accept') {\n    operator.add(h.task_id);\n  }\n}\nconst byOperator = [...operator].filter(t => !(t in passed));\nconst closed = Object.keys(passed).length + byOperator.length;\nconst scores = Object.values(passed).filter(v => v > 0);\nconst attemptTasks = Object.keys(attempts);\nconst ids = new Set();\nfor (const row of [...history, state]) {\n  for (const [k, v] of Object.entries(row)) {\n    if (k.endsWith('_run_id') && typeof v === 'string' && v.startsWith('run_')) ids.add(v);\n  }\n}\nconst statusMap = { completed: 'завершена', failed: 'упала', active: 'идёт' };\nreturn [{ json: {\n  state_key: input.state_key, runner_url: input.runner_url, runner_api_key: input.runner_api_key,\n  run_ids: [...ids],\n  status: statusMap[String(state.status || 'active')] || String(state.status || ''),\n  tasks_closed: `${closed}/${tasks.length} (${tasks.length ? Math.floor(100 * closed / tasks.length) : 0}%)`,\n  closed_by_review_operator: `${Object.keys(passed).length} / ${byOperator.length}`,\n  avg_score: scores.length ? Math.round(scores.reduce((a, b) => a + b, 0) / scores.length) : 0,\n  attempts_per_task: attemptTasks.length\n    ? Math.round(10 * attemptTasks.reduce((a, t) => a + attempts[t], 0) / attemptTasks.length) / 10 : 0,\n} }];"}, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [660, 0], "id": "mr-compute", "name": "Compute Mission Row", "onError": "continueRegularOutput"}, {"parameters": {"method": "POST", "url": "={{ String($json.runner_url || 'http://claude-runner:8700').replace(/\\/+$/, '') + '/v1/stats/runs' }}", "sendHeaders": true, "headerParameters": {"parameters": [{"name": "Content-Type", "value": "application/json"}, {"name": "Authorization", "value": "={{ String($json.runner_api_key || '').trim() ? 'Bearer ' + String($json.runner_api_key).trim() : '' }}"}]}, "sendBody": true, "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ run_ids: $json.run_ids }) }}", "options": {"timeout": 60000, "response": {"response": {"neverError": true}}}}, "type": "n8n-nodes-base.httpRequest", "typeVersion": 4.2, "position": [880, 0], "id": "mr-stats", "name": "Runner Stats", "onError": "continueRegularOutput"}, {"parameters": {"jsCode": "const base = $('Compute Mission Row').first().json;\nconst s = $json && typeof $json === 'object' ? $json : {};\nconst ok = typeof s.worker_hours === 'number';\nconst f1 = v => (Math.round(v * 10) / 10).toFixed(1);\nreturn [{ json: {\n  ok,\n  mission_id: base.state_key,\n  status: base.status,\n  tasks_closed: base.tasks_closed,\n  closed_by_review_operator: base.closed_by_review_operator,\n  avg_score: base.avg_score,\n  attempts_per_task: base.attempts_per_task,\n  worker_hours_review_min: ok ? `${f1(s.worker_hours)} ч / ${Math.round(s.reviewer_minutes)} мин` : '',\n  cost_estimate_real_usd: ok ? `$${f1(s.cost_estimate_usd)} / $${f1(s.cost_real_usd)}` : '',\n  tok_per_s: ok ? s.tok_per_s : 0,\n  cache: ok ? `${Math.round(100 * s.cache_ratio)}%` : '',\n} }];"}, "type": "n8n-nodes-base.code", "typeVersion": 2, "position": [1100, 0], "id": "mr-format", "name": "Format Results Row", "onError": "continueRegularOutput"}, {"parameters": {"conditions": {"options": {"caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2}, "conditions": [{"id": "mr-ok", "leftValue": "={{ $json.ok }}", "rightValue": "", "operator": {"type": "boolean", "operation": "true", "singleValue": true}}], "combinator": "and"}, "options": {}}, "type": "n8n-nodes-base.if", "typeVersion": 2.2, "position": [1320, 0], "id": "mr-if", "name": "Runner Stats Available?", "onError": "continueRegularOutput"}, {"parameters": {"operation": "upsert", "dataTableId": {"__rl": true, "mode": "name", "value": "mission_results"}, "matchType": "allConditions", "filters": {"conditions": [{"keyName": "mission_id", "keyValue": "={{ $json.mission_id }}"}]}, "columns": {"mappingMode": "defineBelow", "value": {"mission_id": "={{ $json.mission_id }}", "status": "={{ $json.status }}", "tasks_closed": "={{ $json.tasks_closed }}", "closed_by_review_operator": "={{ $json.closed_by_review_operator }}", "avg_score": "={{ $json.avg_score }