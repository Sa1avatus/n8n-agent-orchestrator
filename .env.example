# Copy to .env next to docker-compose.yml. Never commit .env.
# Read by docker compose for the ahawr-retrieval container of the n8n stack.

# Host directory with the repository Hermes works on; mounted read-only at /workspace.
AHAWR_WORKSPACE_DIR=D:\n8n\workspace
# Drive with the projects named in missions.working_directory (D:\OpenAIProjects\..., D:\ClaudeProjects\...).
# It is mounted at /d (read-write for claude-runner, read-only for ahawr-retrieval), and
# the missions' Windows paths are mapped onto it. The Worker can reach the whole drive; to narrow
# that, replace the drive mount in docker-compose.yml by the project folders you need.
AHAWR_HOST_DRIVE=D:\
# Corpora indexed automatically on first request: corpus_id=root[,corpus_id=root]
RETRIEVAL_BOOTSTRAP_CORPORA=ahawr-workspace=/workspace
# Optional bearer token for the retrieval API (then use a Header Auth credential in n8n).
RETRIEVAL_API_KEY=

# Embeddings: "hashing" (deterministic baseline, no model), "local" (built-in CPU model baked into
# the image, multilingual-e5-small by default; clearly better on Russian task text, see
# retrieval-service/eval/results/2026-09-28-local-models.md) or "openai" (any OpenAI-compatible
# /v1/embeddings endpoint: llama.cpp server, TEI, Ollama, vLLM ...).
# Switching the embedder re-embeds every chunk once on the next request to each corpus.
RETRIEVAL_EMBEDDER=hashing
RETRIEVAL_EMBEDDING_URL=
RETRIEVAL_EMBEDDING_MODEL=
RETRIEVAL_EMBEDDING_API_KEY=
# e5-family models expect prefixes, e.g. "query: " / "passage: "
RETRIEVAL_EMBEDDING_QUERY_PREFIX=
RETRIEVAL_EMBEDDING_PASSAGE_PREFIX=

# Text-only cross-encoder.
#   auto/http: reranker-service at RETRIEVAL_RERANKER_URL when set, otherwise no reranking
#   local: the built-in CPU model baked into the image (no GPU, offline). Opt-in: on the gold sets
#          the small CPU models ranked below no reranking and add seconds per request.
#   none: never rerank
RETRIEVAL_RERANKER=auto
RETRIEVAL_RERANKER_URL=http://host.docker.internal:8200
RETRIEVAL_RERANKER_API_KEY=
RETRIEVAL_RERANKER_TIMEOUT_SECONDS=10
# Built-in model settings (the image bakes jinaai/jina-reranker-v1-tiny-en and
# intfloat/multilingual-e5-small into /models; another model needs a rebuild with --build-arg).
RETRIEVAL_RERANKER_MODEL=jinaai/jina-reranker-v1-tiny-en
# onnxruntime threads for the built-in models (empty = all cores)
RETRIEVAL_RERANKER_THREADS=4
RETRIEVAL_RERANKER_LOCAL_MAX_CHARS=2000

# Backend: auto (rag-platform when configured and reachable, else local) | local | rag_platform
RETRIEVAL_BACKEND=auto
# External rag-platform container (all five values are required to enable it).
RETRIEVAL_RAG_URL=http://host.docker.internal:8100
RETRIEVAL_RAG_API_KEY=
RETRIEVAL_RAG_OWNER_ID=
RETRIEVAL_RAG_PROJECT_ID=
RETRIEVAL_RAG_COLLECTION=
RETRIEVAL_RAG_TIMEOUT_SECONDS=5
RETRIEVAL_RAG_COOLDOWN_SECONDS=30
RETRIEVAL_RAG_MIRROR=true
RETRIEVAL_RAG_FRESH_WINDOW_SECONDS=120

# Cache and logging
RETRIEVAL_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_MAX_ENTRIES=5000
RETRIEVAL_LOG_QUERY_TEXT=true

# ---------------------------------------------------------------------------------------------
# claude-runner (AHAWR v13 — Claude Code). Built and started by: docker compose up -d --build
# ---------------------------------------------------------------------------------------------
# Model access for Claude Code — set ONE of:
#   ANTHROPIC_API_KEY        Claude Console API key (pay per use; recommended for automation)
#   CLAUDE_CODE_OAUTH_TOKEN  token from `claude setup-token` (Pro/Max/Team/Enterprise subscription)
# Amazon Bedrock / Google Vertex / Microsoft Foundry: set their CLAUDE_CODE_USE_* variables instead.
ANTHROPIC_API_KEY=
CLAUDE_CODE_OAUTH_TOKEN=
# Claude Code release baked into the image (npm @anthropic-ai/claude-code), e.g. 2.1.283.
CLAUDE_CODE_VERSION=latest
# Extra Debian packages the Worker needs to build/test your project, e.g. "python3-pip make g++".
CLAUDE_RUNNER_EXTRA_APT_PACKAGES=
# Optional bearer token for the runner API. If set, put the same value into hermes_config.runner_api_key
# (no n8n credential is used). Empty = no auth; the run API has no host port.
CLAUDE_RUNNER_API_KEY=
# Parallel Claude Code processes; more requests wait in the runner's queue.
CLAUDE_RUNNER_MAX_CONCURRENT=2
# Hard limit per run; on expiry the turn is interrupted (the session stays resumable). Eval-heavy Worker runs
# (re-indexing a corpus per measurement) can need 3 h (10800).
CLAUDE_RUNNER_MAX_RUN_SECONDS=3600
# Thinking off for a long task: when the runs of one local Worker session (one task) add up to more than this many seconds,
# the runner switches the local model's thinking off (litellm/runtime/local_thinking) and back on when the task ends. 0 = never.
# AHAWR_THINK_OFF_AFTER_SECONDS=3600
# Step limit (model calls of the task's thinking window; 0 = none; hermes_config.worker_think_off_after_steps overrides): thinking goes off at whichever limit comes first
# AHAWR_THINK_OFF_AFTER_STEPS=0
# Thinking policy for the local Worker: AHAWR_THINK_POLICY=off_first runs the first attempt at a task (prompt "TASK T<n>", n >= FROM_TASK)
# without thinking and a retry after a review with it; the hour limit above then counts the retries only. Empty = no policy.
# AHAWR_THINK_POLICY=off_first
# Memory safety of the Worker (claude-runner/src/claude_runner/mem_guard.py, README): a process that allocates more than this many MB gets MemoryError (0 = off);
# the guard kills the biggest process above MEM_GUARD_PROC_MB, or when the container's anonymous memory passes CGROUP_PERCENT of its limit.
# Restore point before every Worker run (claude-runner/src/claude_runner/git_snapshot.py): the tracked changes are kept under
# refs/ahawr/snapshots/<run_id> (git checkout <ref> -- <file> brings a file back); the newest KEEP refs stay. docker-compose.yml turns it on.
# CLAUDE_RUNNER_WORKER_GIT_SNAPSHOT=1
# CLAUDE_RUNNER_GIT_SNAPSHOT_KEEP=100
# CLAUDE_RUNNER_PROC_DATA_LIMIT_MB=4096
# CLAUDE_RUNNER_MEM_GUARD_PROC_MB=5000
# CLAUDE_RUNNER_MEM_GUARD_CGROUP_PERCENT=85
# Step policy: AHAWR_THINK_POLICY may hold a JSON policy (variants with weights, timelines of ["think"|"off", calls] segments for first attempts and retries) or the older
# pulse:25:10:1 strings; hermes_config.worker_think_policy overrides it per run. Validate with data-tables/ops/set_think_policy.py. See docs/thinking-control.md section 2c.
# AHAWR_THINK_POLICY_FROM_TASK=1
# Price of the local model as if it were a cloud model, USD per million tokens: input,output,cache_read,cache_write. The steps made
# without thinking are priced with the profile named in THINKING_OFF, those made with thinking with THINKING_ON (the figure is what the
# run saved). SONNET was read from real Sonnet 5.5 runs (Claude Code's own cost); check HAIKU against the current price list.
# AHAWR_LOCAL_PRICE_SONNET=2,10,0.2,4
# AHAWR_LOCAL_PRICE_HAIKU=1,5,0.1,1.25
# AHAWR_LOCAL_PRICE_THINKING_OFF=haiku
# AHAWR_LOCAL_PRICE_THINKING_ON=sonnet
# Optional global caps (0 = off).
CLAUDE_RUNNER_MAX_TURNS=0
CLAUDE_RUNNER_MAX_BUDGET_USD=0
# Session compaction requested by the Run Manager before continuing a session:
# auto = /compact only above CLAUDE_RUNNER_COMPACT_MIN_TOKENS of context, always, or off.
CLAUDE_RUNNER_COMPACT_MODE=auto
CLAUDE_RUNNER_COMPACT_MIN_TOKENS=120000
# Text of the compact instructions delivered to Claude Code on every compaction (auto, manual
# /compact, and the runner's /compact before continuing a session). It is appended to the END of
# the compaction request, so its beginning (history + system prompt) stays cache-compatible and
# its prefill is unchanged. The default fixes the required sections, targets 1500-2000 tokens,
# and forbids inserting large outputs. Unset = this built-in short format (recommended);
# set but empty = Claude Code's stock summarizer (long summaries, no custom instructions).
# CLAUDE_RUNNER_COMPACT_INSTRUCTIONS=
# Deliver the instructions to runs of the local provider (PreCompact hook + "/compact <text>"):
# 1 = on, 0 = off (Claude Code's stock summarizer for the local model too).
CLAUDE_RUNNER_LOCAL_COMPACT_INSTRUCTIONS=1
# Time limit for the runner's /compact before continuing a session, in seconds.
CLAUDE_RUNNER_COMPACT_TIMEOUT_SECONDS=600
# Cloud thinking: 1 = apply the local thinking policy to cloud (Anthropic) runs per attempt,
# 0 = the CLI's default thinking behaviour for the chosen model (off by default).
# CLAUDE_RUNNER_CLOUD_THINK=
# Retry in a fresh session instead of compacting the old one (off by default).
# CLAUDE_RUNNER_RETRY_FRESH_SESSION=0
# Read providers from the database (board.providers) with the env blocks as fallback; 1 = on, empty = off (docs/providers.md section 11).
CLAUDE_RUNNER_PROVIDERS_DB=
# Master key of the encrypted provider secrets file (Fernet; python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
# The file is /secrets/provider-secrets.json on the shared volume ahawr-provider-secrets; crypto.txt next to it holds the word 'encrypted'.
CLAUDE_RUNNER_SECRETS_KEY=
# Write the LiteLLM route entries from the database to LiteLLM; 1 = on, empty = off (docs/providers.md section 13).
CLAUDE_RUNNER_LITELLM_SYNC=
# Provider secrets file (mode 0600); empty = provider-secrets.json in CLAUDE_RUNNER_DATA_DIR.
CLAUDE_RUNNER_SECRETS_FILE=
# Character budget for the fresh-session retry input (task, findings, report, digest).
# CLAUDE_RUNNER_RETRY_INPUT_CHARS=32000
# Per-role Claude Code permissions (defaults shown in claude-runner/README.md), e.g.:
# CLAUDE_RUNNER_WORKER_PERMISSION_MODE=bypassPermissions
# CLAUDE_RUNNER_WORKER_DISALLOWED_TOOLS=Read(./.env),Read(./.env.local),Bash(git commit *),Bash(git push *)
# (setting it replaces the default deny list; do not use Read(./.env.*): it also hides .env.example)
# CLAUDE_RUNNER_REVIEWER_PERMISSION_MODE=dontAsk
# CLAUDE_RUNNER_REVIEWER_DISALLOWED_TOOLS=Edit,Write,NotebookEdit
# The Reviewer may run read-only Bash (ahawr-search, grep, ls, wc, git diff/status/log/show...) by default.
# Setting this replaces that list; empty = no Bash for the Reviewer; a narrow build check can be added:
# CLAUDE_RUNNER_REVIEWER_ALLOWED_TOOLS=Bash(ahawr-search *),Bash(grep *),Bash(git diff *),Bash(bash /d/rag-tmp/verify.sh)
# Extra folders a role may read besides the run's working directory (--add-dir), comma-separated;
# e.g. a Worker's scratch folder outside the project that the Reviewer must check:
# CLAUDE_RUNNER_REVIEWER_ADD_DIRS=/tmp/dcfr-work,/d/rag-tmp,/d/OpenAIProjects/llama.cpp   (folders outside the mission's working directory the read-only Reviewer may read)
# Extra prompt text appended to the role's system prompt (default: none). Used to enable the
# opt-in RESULT PLACEMENT RULE (see claude-runner/README.md, "Reviewer result access"):
# CLAUDE_RUNNER_WORKER_APPEND_SYSTEM_PROMPT=RESULT PLACEMENT RULE: place every file the Reviewer must verify (notes, artifacts, logs) in the mission working directory or a subfolder of it — never in /tmp or elsewhere — and cite its exact path in your report. The Reviewer reads only the mission working directory.
# CLAUDE_RUNNER_ARCHITECT_APPEND_SYSTEM_PROMPT=RESULT PLACEMENT RULE: name in each task's `scope` or `acceptance_criteria` the exact path(s) — inside the mission working directory or a subfolder of it — where the Worker must place the files the Reviewer will verify (notes, artifacts, logs). Do not place those files in /tmp or outside the mission folder: the Reviewer reads only the mission working directory.
# Extra CLI flags for every run, e.g. "--effort high".
CLAUDE_RUNNER_EXTRA_ARGS=
# Smaller built-in tool set (--tools) for every role, or per role with CLAUDE_RUNNER_<ROLE>_TOOLS.
# Empty = Claude Code's default set (~12k tokens of tool definitions).
CLAUDE_RUNNER_TOOLS=
HOST_ACTIONS=
# Operator secret for the runner's POST /v1/host-actions/<id>/operator route (dashboard confirm/reject).
# Kept in the ahawr-dashboard and claude-runner environments, never in a Worker run environment
# (child_env strips every CLAUDE_RUNNER_* key). Empty = the operator route is refused 401.
CLAUDE_RUNNER_HOST_ACTIONS_OPERATOR_KEY=
# ---------------------------------------------------------------------------------------------
# AHAWR dashboard (container ahawr-dashboard): http://localhost:8701, read-only, 127.0.0.1 only.
# Every run of every role, Claude Code and Hermes: thinking, tool calls with results, answers,
# steps with timings (TTFT, generation, tok/s) and tokens (input, cache, output), retries, errors.
# ---------------------------------------------------------------------------------------------
AHAWR_DASHBOARD_PORT=8701
# Hermes API server (the one Hermes Run Manager calls) and its API_SERVER_KEY, the same value as
# the n8n "Bearer Auth account" credential. Empty HERMES_API_URL= hides Hermes.
HERMES_API_URL=http://host.docker.internal:8642
HERMES_API_KEY=
# Which Hermes sessions to show: api_server = the ones AHAWR starts; empty = all (Telegram, CLI...).
HERMES_SESSION_SOURCE=api_server
# Dashboard guard supervisor (docs/guards.md, "Container guards planned"): DASHBOARD_GUARDS=1
# starts the registered guards; DASHBOARD_GUARDS_DRY_RUN=1 records actions without performing
# them. Notices go to Telegram through the container variables below; names only, no values here.
# Per-guard switches: DASHBOARD_GUARDS_<NAME>_ENABLED / DASHBOARD_GUARDS_<NAME>_INTERVAL.
DASHBOARD_GUARDS=
DASHBOARD_GUARDS_DRY_RUN=
DASHBOARD_TELEGRAM_BOT_TOKEN=
DASHBOARD_TELEGRAM_CHAT_ID=
# Per-guard enable switches (read when DASHBOARD_GUARDS=1).
DASHBOARD_GUARDS_IDLE_ENABLED=
DASHBOARD_GUARDS_MISSION_NOTICE_ENABLED=
DASHBOARD_GUARDS_QUEUE_RESTART_ENABLED=
DASHBOARD_GUARDS_HOST_HEARTBEAT_ENABLED=
DASHBOARD_GUARDS_TG_RELAY_ENABLED=
# Maximum guard notices per minute across all guards.
DASHBOARD_GUARDS_NOTICE_LIMIT=
# Idle-watch guard: container path of the seen-state file (empty = no seen state kept).
DASHBOARD_GUARDS_QUEUE_STATE_PATH=
# Queue-restart guard: container directory for the queue_restart.req request file (read-write mount).
DASHBOARD_GUARDS_QUEUE_REQUEST_DIR=
# Orphan-process guard: consecutive closed-run checks that confirm one pid.
DASHBOARD_GUARDS_ORPHAN_CONFIRM_CHECKS=
# Interrupt-loop guard: interrupted runs that count as one loop.
DASHBOARD_GUARDS_INTERRUPT_LOOP_THRESHOLD=
# Interrupt-loop guard: length of the counting window in seconds.
DASHBOARD_GUARDS_INTERRUPT_LOOP_WINDOW_S=
# Interrupt-loop guard: a run that ends within this many seconds counts as interrupted.
DASHBOARD_GUARDS_INTERRUPT_LOOP_QUICK_S=
# Host-heartbeat guard: container directory holding the heartbeat files.
DASHBOARD_GUARDS_HEARTBEAT_DIR=
# Host-heartbeat guard: seconds after which a heartbeat counts as stale.
DASHBOARD_GUARDS_HEARTBEAT_STALE_S=
# Telegram relay guard: n8n webhook URL as seen from the container; a secret-like value, set it in the environment.
DASHBOARD_GUARDS_TG_WEBHOOK_URL=
# Telegram relay guard: container path of the getUpdates offset file (read-write state mount).
DASHBOARD_GUARDS_TG_OFFSET_PATH=
DASHBOARD_OPS_TAB=
# ---------------------------------------------------------------------------------------------
# AHAWR Telegram control bot (workflow AHAWR_Status_Bot.json, docs/telegram-bot.md).
# Since 0.4.0 it does not poll: data-tables/ops/tg_relay.py long-polls Telegram with TELEGRAM_BOT_TOKEN and posts each update to the
# workflow's webhook (path AHAWR_TG_WEBHOOK_PATH); the POLL/TIMEOUT variables below are no longer used. The bot answers only the
# chats named in hermes_config.telegram_chat_id — no .env variable of its own. The bot token
# lives in the n8n telegramApi credential (replies) and in TELEGRAM_BOT_TOKEN below (the relay), never in a workflow file. Commands: /status,
# /missions, /agents, /start, /stop, /restart, /pause, /retry, /accept, /steer, /queue,
# /set, /model, /undo, /approve, /deny, /help, /commands (full list in docs/telegram-bot.md).
# If the Hermes gateway runs its own Telegram bot, that bot needs its own token: one token
# can have only one getUpdates consumer.
# Bot token for tg_relay.py (getUpdates), from BotFather. Never commit it. The n8n credential 'Telegram account' needs the same token for the replies.
TELEGRAM_BOT_TOKEN=
# Secret path of the bot workflow's webhook (generate once, e.g. tg- plus 32 random hex characters); the same value goes into the workflow on deploy.
AHAWR_TG_WEBHOOK_PATH=
# Poll interval in seconds (default 30; keep it >= 30 to stay under ~3000 executions/day).
TELEGRAM_STATUS_BOT_POLL_SECONDS=
# Long-poll getUpdates timeout in seconds (default 30; keep it 25..30).
TELEGRAM_STATUS_BOT_TIMEOUT_SECONDS=
# Seconds a pending confirmation (inline button or one-time code) stays valid (default 120).
TELEGRAM_STATUS_BOT_CONFIRM_TTL_SECONDS=
# Audit data table that every confirmed mutation is written to
# (default "AHAWR Bot Audit Log"; the table must exist in n8n).
TELEGRAM_STATUS_BOT_AUDIT_TABLE=
# claude-runner: token-by-token live view and step timings (--include-partial-messages);
# false = whole blocks and token counts only.
CLAUDE_RUNNER_LIVE_TOKENS=true
# Days to keep run activity logs (/data/events/<run_id>.jsonl in the claude-runner-data volume).
CLAUDE_RUNNER_EVENT_RETENTION_DAYS=14

# ---------------------------------------------------------------------------------------------
# Local model per role: Claude Code → LiteLLM → llama.cpp (OpenAI-compatible llama-server)
# ---------------------------------------------------------------------------------------------
# Like Hermes' *_provider: each AHAWR role sends its hermes_config provider, and claude-runner
# picks the matching provider block below. Roles whose provider has no block ("anthropic") use
# the credential above (ANTHROPIC_API_KEY or CLAUDE_CODE_OAUTH_TOKEN) and go to Anthropic
# directly. A role with provider "local" uses this block: Claude Code → litellm → llama.cpp,
# and does NOT receive the Anthropic credential.
# hermes_config (claude-code row), e.g.:
#   architect_model=opus  architect_provider=anthropic
#   reviewer_model=opus   reviewer_provider=anthropic
#   worker_model=<model name as llama-server knows it, see GET /v1/models>  worker_provider=local
#   The model is chosen ONLY here: LiteLLM passes the name to llama-server unchanged, and
#   claude-runner uses it for Claude Code's background tasks and subagents too.
#
# llama-server on the host, with tool calling and a real context window:
#   llama-server -m model.gguf --jinja -c 32768 --host 0.0.0.0 --port 8080
#
# LiteLLM side (litellm container; see litellm/config.yaml):
# LLAMACPP_API_BASE=http://host.docker.internal:8080/v1
# LLAMACPP_API_KEY=none            # the llama-server --api-key, if it has one
# LITELLM_MASTER_KEY=sk-change-me-long-random
#
# Provider "local" for claude-runner: CLAUDE_RUNNER_PROVIDER_<NAME>__<VARIABLE> (two "_").
# Every <VARIABLE> is set for Claude Code on runs of that provider only; TOOLS and
# COMPACT_MIN_TOKENS configure the runner.
# CLAUDE_RUNNER_PROVIDER_LOCAL__ANTHROPIC_BASE_URL=http://litellm:4000
# CLAUDE_RUNNER_PROVIDER_LOCAL__ANTHROPIC_AUTH_TOKEN=sk-change-me-long-random
# Match llama-server -c; Claude Code otherwise assumes 200k and compacts too late:
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_CODE_MAX_CONTEXT_TOKENS=65536
# Better: let the runner read the model's -c from llama-server before each run (GET /v1/models,
# the model's --ctx-size) and set the window and autocompact trigger to it; the static values
# above and below are the fallback when llama-server does not answer. docker-compose.yml sets it
# to http://host.docker.internal:8033 with the key LLAMACPP_API_KEY; empty = static only.
# LLAMACPP_CONTEXT_PROBE_URL=http://host.docker.internal:8033
# The trigger as a percentage of the probed window (default: 67.66, the static 44344 / 65536),
# capped at window - min(max_output, 20000) - 13000:
# CLAUDE_RUNNER_PROVIDER_LOCAL__COMPACT_PCT=70
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_CODE_MAX_OUTPUT_TOKENS=8192
# Cap one tool output so a single Bash/Read result cannot fill the window (Claude Code saves the
# rest to a file): Bash output in characters, Read output in tokens.
# CLAUDE_RUNNER_PROVIDER_LOCAL__BASH_MAX_OUTPUT_LENGTH=12000
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS=10000
# Tool output limits for the local Worker only (Part B, docs/cold-prefill.md section 3):
# when set, claude-runner injects BASH_MAX_OUTPUT_LENGTH=12000 and
# CLAUDE_CODE_FILE_READ_MAX_OUTPUT_TOKENS=16000 into the env of the Worker run on the local
# provider; the Reviewer and Architect on Anthropic are not affected, and with this variable
# unset (the default) the env every role receives is unchanged. Measured savings: 688,097
# chars ≈ 229,000 tokens ≈ 1.2% of the snapshot's tool_result total per full snapshot.
# AHAWR_LOCAL_TOOL_OUTPUT_LIMITS=
# Local runs start their prompt the same way for every task (1, default): CLAUDE_CODE_ATTRIBUTION_HEADER=0 (no per-task hash at char 47)
# and CLAUDE_CODE_DISABLE_AUTO_MEMORY=1 (no working-directory path at char ~2700). 85% of the first request is then shared between tasks.
# AHAWR_LOCAL_SHARED_PREFIX=1
# No Anthropic-specific thinking / prompt caching / telemetry for the local model:
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_CODE_DISABLE_THINKING=1
# CLAUDE_RUNNER_PROVIDER_LOCAL__DISABLE_PROMPT_CACHING=1
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
# System prompt ~15k → ~4k tokens with a small tool set:
# CLAUDE_RUNNER_PROVIDER_LOCAL__TOOLS=Bash,Read,Edit,Write,Glob,Grep
# The runner's /compact before resuming a session: only above this context size (below Claude
# Code's own ~44K trigger, so a resumed session starts with room to work):
# CLAUDE_RUNNER_PROVIDER_LOCAL__COMPACT_MIN_TOKENS=40000
# With CONTEXT_PROBE_URL the threshold scales with the probed window (40000 of 65536 = 61%:
# 60000 at 96K), or set it as a percentage of the window (capped at the autocompact trigger):
# CLAUDE_RUNNER_PROVIDER_LOCAL__COMPACT_MIN_PCT=61
# Refuse exploratory grep/rg/find from local Workers until they have used ahawr-search (a
# PreToolUse hook), then remind every N such searches (0 = never). docker-compose.yml enables it
# for LOCAL; set AHAWR_SEARCH_FIRST=0 to turn it off, or use CLAUDE_RUNNER_SEARCH_FIRST=1 for all
# providers and CLAUDE_RUNNER_SEARCH_FIRST_ROLES=worker,generic for other roles.
# AHAWR_SEARCH_FIRST=1
# CLAUDE_RUNNER_SEARCH_FIRST_EVERY=6
# Full 65536-token window: trigger = 65536 - 8192 - 13000 = 44344 (~44K),
# headroom 21192 >= 20000 (one large tool output).
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_CODE_AUTO_COMPACT_WINDOW=65536
# Alternative: the trigger as a percentage of the window (overrides AUTO_COMPACT_WINDOW). The
# runner refuses to start if the trigger leaves less than 20000 tokens of headroom below 65536.
# CLAUDE_RUNNER_PROVIDER_LOCAL__CLAUDE_AUTOCOMPACT_PCT_OVERRIDE=67
#
# Do NOT set ANTHROPIC_BASE_URL / ANTHROPIC_AUTH_TOKEN globally for this: they would send every
# role, including the Anthropic ones, to LiteLLM.

# Retrieval index in PostgreSQL instead of the SQLite file (used since 0.4.0): create the role/database retrieval in ahawr-postgres (RETRIEVAL_PG_PASSWORD), copy the embeddings with
# retrieval-service/scripts/sqlite_to_postgres.py, then
# RETRIEVAL_DATABASE_URL=postgresql://retrieval:${RETRIEVAL_PG_PASSWORD}@ahawr-postgres:5432/retrieval
# RETRIEVAL_DATABASE_SCHEMA=retrieval
# RETRIEVAL_SYNC_WAIT_SECONDS=0   (a retrieve request waits at most this long for the background sync, then answers from the current index; 0 = never waits, the sync runs in the background; -1 = synchronous sync)
# Thinking turns on when the Worker repeats the same tool call this many times in a row (0 = off), and stays on for this many model calls
# CLAUDE_RUNNER_THINK_LOOP_REPEATS=4
# CLAUDE_RUNNER_THINK_LOOP_HOLD_STEPS=12

# Where the Worker's scratch folders live on the host (missions use /tmp/<name> inside the container); they survive container recreation.
# Thinking turns on when the Worker makes this many model calls in a row without editing a file (Edit, Write, NotebookEdit, or a Bash command with > or sed -i), counted after the first 6 model calls (0 = off)
# CLAUDE_RUNNER_THINK_STUCK_NOEDIT_STEPS=12
# Thinking turns on when the same tool error (the start of its output) comes this many times (0 = off)
# CLAUDE_RUNNER_THINK_STUCK_ERRORS=3
# Lessons library (claude-runner/docs/lessons.md, "Activation (operator)"): these are not environment variables. The switches are read from
# the hermes_config row (lessons_enabled) and the mission config (lessons_holdout_enabled); the names are listed here only, with no value.
# lessons_enabled=
# lessons_holdout_enabled=
# AHAWR_SCRATCH_DIR=D:\n8n\runner-scratch
# LiteLLM prompt-cache diagnostics: one JSON line per local-model request in litellm/trace/cache_trace.jsonl (1 = on, the default in compose).
# AHAWR_CACHE_TRACE=1
# 1 = drop the thinking of earlier steps from the context of local models (litellm/ahawr_hooks.py drop_history_thinking); 0 = keep (default).
# AHAWR_DROP_HISTORY_THINKING=0
# Password of the throwaway QA Postgres (profile qa-container). Any random string; it protects nothing real.
QA_PG_PASSWORD=

# Guard editing in the dashboard (Guards tab): turn a guard on or off and change its poll interval and
# health window at run time; the choice is kept in the guards state directory. Off by default.
# DASHBOARD_GUARDS_EDIT=1
