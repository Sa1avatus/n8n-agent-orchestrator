{
  "description": "Shared cases for the engine core (board_engine.py, and board_engine.js when it exists). parse[].engine_json is the raw text of the engine_json column; legacy is the legacy row (null or an empty string = empty column). validate_engine_json(engine_json) returns the errors; flatten(engine_json, legacy) returns the legacy constants, or raises ValueError when a value it uses is invalid. error_rule_cases: match_error_rule(rules, http, code, text) returns the first matching rule (rules 'recommended' = RECOMMENDED_ERROR_RULES, [] = LEGACY_ERROR_RULES) or null.Values other than the legacy_constants are made up. Golden: an empty or missing engine_json with empty legacy columns flattens to legacy_constants.",
  "legacy_constants": {
    "max_attempts_per_task": 5,
    "retry_delays": [15, 30, 60, 120, 300],
    "runner_url": "http://claude-runner:8700",
    "run_manager_workflow_id": "nhjwX1G7FiVTO2Ah",
    "telegram_chat_id": ""
  },
  "parse": [
    {
      "name": "golden_empty",
      "engine_json": "",
      "legacy": {},
      "expect": { "errors": [], "flatten_equals": "legacy_constants" }
    },
    {
      "name": "golden_missing",
      "engine_json": null,
      "legacy": { "max_attempts_per_task": null, "retry_delays_json": null, "runner_url": null },
      "expect": { "errors": [], "flatten_equals": "legacy_constants" }
    },
    {
      "name": "golden_blank_legacy_values",
      "engine_json": "{}",
      "legacy": {
        "max_attempts_per_task": null,
        "retry_delays_json": "  ",
        "runner_url": " ",
        "run_manager_workflow_id": "",
        "telegram_chat_id": null
      },
      "expect": { "errors": [], "flatten_equals": "legacy_constants" }
    },
    {
      "name": "json_wins_over_legacy",
      "engine_json": "{\"max_attempts_per_task\": 3, \"retry_delays\": [1, 2], \"runner_url\": \"http://made-runner-a:9000/\"}",
      "legacy": {
        "max_attempts_per_task": 7,
        "retry_delays_json": "[9]",
        "runner_url": "http://made-runner-b:9001",
        "run_manager_workflow_id": "made-workflow-1",
        "telegram_chat_id": "made-chat-1"
      },
      "expect": {
        "errors": [],
        "flatten_partial": {
          "max_attempts_per_task": 3,
          "retry_delays": [1, 2],
          "runner_url": "http://made-runner-a:9000",
          "run_manager_workflow_id": "made-workflow-1",
          "telegram_chat_id": "made-chat-1"
        }
      }
    },
    {
      "name": "legacy_fallback_per_key",
      "engine_json": "{}",
      "legacy": {
        "max_attempts_per_task": 7,
        "retry_delays_json": "[5, 10]",
        "runner_url": "http://made-runner-b:9001/",
        "run_manager_workflow_id": "made-workflow-1",
        "telegram_chat_id": "made-chat-1"
      },
      "expect": {
        "errors": [],
        "flatten_partial": {
          "max_attempts_per_task": 7,
          "retry_delays": [5, 10],
          "runner_url": "http://made-runner-b:9001",
          "run_manager_workflow_id": "made-workflow-1",
          "telegram_chat_id": "made-chat-1"
        }
      }
    },
    {
      "name": "mixed_keys_json_and_default",
      "engine_json": "{\"telegram_chat_id\": \"made-chat-2\"}",
      "legacy": { "max_attempts_per_task": 4 },
      "expect": {
        "errors": [],
        "flatten_partial": {
          "max_attempts_per_task": 4,
          "retry_delays": [15, 30, 60, 120, 300],
          "telegram_chat_id": "made-chat-2"
        }
      }
    },
    {
      "name": "blank_json_value_counts_as_absent",
      "engine_json": "{\"runner_url\": \"  \", \"run_manager_workflow_id\": \"\"}",
      "legacy": { "runner_url": "http://made-runner-c:9002" },
      "expect": {
        "errors": [],
        "flatten_partial": {
          "runner_url": "http://made-runner-c:9002",
          "run_manager_workflow_id": "nhjwX1G7FiVTO2Ah"
        }
      }
    },
    {
      "name": "legacy_retry_delays_json_string",
      "engine_json": "",
      "legacy": { "retry_delays_json": "[\"1\", 2.5]" },
      "expect": { "errors": [], "flatten_partial": { "retry_delays": [1, 2.5] } }
    },
    {
      "name": "legacy_retry_delays_empty_array",
      "engine_json": "",
      "legacy": { "retry_delays_json": "[]" },
      "expect": { "errors": [], "flatten_partial": { "retry_delays": [] } }
    },
    {
      "name": "json_retry_delays_as_string",
      "engine_json": "{\"retry_delays\": \"[3, 6]\"}",
      "legacy": { "retry_delays_json": "[9]" },
      "expect": { "errors": [], "flatten_partial": { "retry_delays": [3, 6] } }
    },
    {
      "name": "invalid_json",
      "engine_json": "{",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json is not valid JSON"] }
    },
    {
      "name": "nan_not_allowed",
      "engine_json": "{\"max_attempts_per_task\": NaN}",
      "legacy": {},
      "expect": { "errors_contain": ["NaN is not allowed in JSON"] }
    },
    {
      "name": "not_an_object",
      "engine_json": "[1]",
      "legacy": {},
      "expect": { "errors": ["engine_json must be a JSON object"] }
    },
    {
      "name": "unknown_key",
      "engine_json": "{\"max_tasks\": 30}",
      "legacy": {},
      "expect": { "errors": ["engine_json: unknown key \"max_tasks\""] }
    },
    {
      "name": "max_attempts_below_minimum",
      "engine_json": "{\"max_attempts_per_task\": 0}",
      "legacy": {},
      "expect": {
        "errors": ["engine_json.max_attempts_per_task must be a number of at least 1, got 0"]
      }
    },
    {
      "name": "max_attempts_boolean",
      "engine_json": "{\"max_attempts_per_task\": true}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.max_attempts_per_task must be a number"] }
    },
    {
      "name": "max_attempts_string",
      "engine_json": "{\"max_attempts_per_task\": \"5\"}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.max_attempts_per_task must be a number"] }
    },
    {
      "name": "retry_delays_negative_element",
      "engine_json": "{\"retry_delays\": [1, -1]}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.retry_delays must hold numbers >= 0"] }
    },
    {
      "name": "retry_delays_not_a_list",
      "engine_json": "{\"retry_delays\": 5}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.retry_delays must be a JSON array"] }
    },
    {
      "name": "runner_url_not_a_string",
      "engine_json": "{\"runner_url\": 8700}",
      "legacy": {},
      "expect": { "errors": ["engine_json.runner_url must be a string, got 8700"] }
    },
    {
      "name": "telegram_chat_id_not_a_string",
      "engine_json": "{\"telegram_chat_id\": -1001}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.telegram_chat_id must be a string"] }
    },
    {
      "name": "error_rules_valid",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"match\": {\"http\": [400], \"words\": [\"x\"], \"codes\": [\"y\"]}, \"action\": \"retry\", \"retries\": 0, \"note\": \"n\"}]}",
      "legacy": {},
      "expect": { "errors": [] }
    },
    {
      "name": "error_rules_bad_action",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"action\": \"explode\", \"retries\": 1}]}",
      "legacy": {},
      "expect": {
        "errors_contain": ["engine_json.error_rules[0].action must be one of compact, fail, failover, retry"]
      }
    },
    {
      "name": "error_rules_retries_above_bound",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"action\": \"retry\", \"retries\": 6}]}",
      "legacy": {},
      "expect": {
        "errors_contain": ["engine_json.error_rules[0].retries must be an integer from 0 to 5, got 6"]
      }
    },
    {
      "name": "error_rules_retries_not_an_integer",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"action\": \"retry\", \"retries\": 1.5}]}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.error_rules[0].retries must be an integer from 0 to 5"] }
    },
    {
      "name": "error_rules_too_many",
      "engine_json": "{\"error_rules\": [{\"id\": \"r0\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r1\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r2\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r3\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r4\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r5\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r6\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r7\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r8\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r9\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r10\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r11\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r12\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r13\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r14\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r15\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r16\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r17\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r18\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r19\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r20\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r21\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r22\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r23\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r24\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r25\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r26\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r27\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r28\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r29\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r30\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r31\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r32\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r33\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r34\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r35\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r36\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r37\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r38\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r39\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"r40\", \"action\": \"fail\", \"retries\": 0}]}",
      "legacy": {},
      "expect": { "errors": ["engine_json.error_rules must hold at most 40 rules, got 41"] }
    },
    {
      "name": "error_rules_duplicate_id",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"action\": \"fail\", \"retries\": 0}, {\"id\": \"a\", \"action\": \"retry\", \"retries\": 1}]}",
      "legacy": {},
      "expect": { "errors": ["engine_json.error_rules: duplicate id \"a\""] }
    },
    {
      "name": "error_rules_empty_id",
      "engine_json": "{\"error_rules\": [{\"id\": \" \", \"action\": \"fail\", \"retries\": 0}]}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.error_rules[0].id must be a non-empty string"] }
    },
    {
      "name": "error_rules_unknown_rule_key",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"action\": \"fail\", \"retries\": 0, \"bogus\": 1}]}",
      "legacy": {},
      "expect": { "errors": ["engine_json.error_rules[0]: unknown key \"bogus\""] }
    },
    {
      "name": "error_rules_unknown_match_key",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"match\": {\"text\": [\"x\"]}, \"action\": \"fail\", \"retries\": 0}]}",
      "legacy": {},
      "expect": { "errors": ["engine_json.error_rules[0].match: unknown key \"text\""] }
    },
    {
      "name": "error_rules_http_not_integers",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"match\": {\"http\": [\"400\"]}, \"action\": \"fail\", \"retries\": 0}]}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.error_rules[0].match.http must be a list of integers"] }
    },
    {
      "name": "error_rules_words_not_strings",
      "engine_json": "{\"error_rules\": [{\"id\": \"a\", \"match\": {\"words\": [400]}, \"action\": \"fail\", \"retries\": 0}]}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.error_rules[0].match.words must be a list of strings"] }
    },
    {
      "name": "error_rules_not_a_list",
      "engine_json": "{\"error_rules\": {}}",
      "legacy": {},
      "expect": { "errors_contain": ["engine_json.error_rules must be a JSON array of rules"] }
    }
  ],
  "error_rule_cases": [
    {
      "name": "legacy_context_code",
      "rules": [],
      "error": { "http": null, "code": "context_window", "text": "" },
      "expect": { "rule_id": "legacy-context-code", "action": "compact", "retries": 3 }
    },
    {
      "name": "legacy_context_words",
      "rules": [],
      "error": { "http": null, "code": "", "text": "Prompt is too long for this model" },
      "expect": { "rule_id": "legacy-context-words", "action": "compact", "retries": 3 }
    },
    {
      "name": "legacy_transient_http",
      "rules": [],
      "error": { "http": 503, "code": "", "text": "" },
      "expect": { "rule_id": "legacy-transient-http", "action": "retry", "retries": 3 }
    },
    {
      "name": "legacy_transient_words",
      "rules": [],
      "error": { "http": null, "code": "", "text": "Connection refused by upstream" },
      "expect": { "rule_id": "legacy-transient-words", "action": "retry", "retries": 3 }
    },
    {
      "name": "legacy_no_match_is_permanent",
      "rules": [],
      "error": { "http": 418, "code": "", "text": "teapot" },
      "expect": { "rule_id": null }
    },
    {
      "name": "recommended_weekly_limit_retries",
      "rules": "recommended",
      "error": { "http": null, "code": "", "text": "You've hit your weekly limit" },
      "expect": { "rule_id": "weekly-limit-text", "action": "retry", "retries": 2 }
    },
    {
      "name": "recommended_weekly_limit_with_429",
      "rules": "recommended",
      "error": { "http": 429, "code": "rate_limit", "text": "You've hit your weekly limit" },
      "expect": { "rule_id": "weekly-limit-text", "action": "retry", "retries": 2 }
    },
    {
      "name": "recommended_rate_limit_429",
      "rules": "recommended",
      "error": { "http": 429, "code": "rate_limit", "text": "rate limit reached" },
      "expect": { "rule_id": "rate-limit-429", "action": "retry", "retries": 2 }
    },
    {
      "name": "recommended_transient_5xx",
      "rules": "recommended",
      "error": { "http": 503, "code": "overloaded", "text": "upstream request timeout" },
      "expect": { "rule_id": "transient-5xx", "action": "retry", "retries": 2 }
    },
    {
      "name": "recommended_poolside_400_failover_at_once",
      "rules": "recommended",
      "error": {
        "http": 400,
        "code": "api_error",
        "text": "API Error: 400 poolside/laguna-s-2.1:free is no longer available on OpenRouter: no provider serves this model anymore"
      },
      "expect": { "rule_id": "model-gone", "action": "failover", "retries": 0 }
    },
    {
      "name": "recommended_credits_402",
      "rules": "recommended",
      "error": { "http": 402, "code": "", "text": "Insufficient credits" },
      "expect": { "rule_id": "credits-402", "action": "failover", "retries": 0 }
    },
    {
      "name": "recommended_auth_401",
      "rules": "recommended",
      "error": { "http": 401, "code": "", "text": "Invalid API key" },
      "expect": { "rule_id": "auth-401-403", "action": "failover", "retries": 0 }
    },
    {
      "name": "recommended_context_413",
      "rules": "recommended",
      "error": { "http": 413, "code": "", "text": "context length exceeded" },
      "expect": { "rule_id": "context-413", "action": "compact", "retries": 2 }
    },
    {
      "name": "recommended_other_400_retries",
      "rules": "recommended",
      "error": { "http": 400, "code": "", "text": "bad request" },
      "expect": { "rule_id": "other-400", "action": "retry", "retries": 2 }
    },
    {
      "name": "recommended_else_fail",
      "rules": "recommended",
      "error": { "http": null, "code": "", "text": "something odd" },
      "expect": { "rule_id": "else-fail", "action": "fail", "retries": 0 }
    }
  ],
  "flatten_errors": [
    {
      "name": "invalid_legacy_retry_delays_used",
      "engine_json": "",
      "legacy": { "retry_delays_json": "[1," },
      "error_contains": "retry_delays_json is not valid JSON"
    },
    {
      "name": "invalid_legacy_attempts_used",
      "engine_json": "{}",
      "legacy": { "max_attempts_per_task": 0 },
      "error_contains": "max_attempts_per_task must be a number of at least 1"
    },
    {
      "name": "invalid_legacy_ignored_when_json_wins",
      "engine_json": "{\"retry_delays\": [4]}",
      "legacy": { "retry_delays_json": "[1," },
      "flatten_partial": { "retry_delays": [4] }
    }
  ]
}
